{
  "browser": { "mode": "launch", "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" },
  "start_url": { "url": "http://localhost:5180/import?mode=paste" },
  "environment": { "viewport": { "width": 1440, "height": 900 }, "locale": "pt-BR" },
  "actions": [
    { "step_id": "import-ready", "action": "wait_for", "locator": { "kind": "css", "selector": "#imp-text" }, "state": "visible", "timeout_ms": 10000 },
    { "step_id": "import-name", "action": "fill", "locator": { "kind": "css", "selector": "#imp-name" }, "value": { "source": "literal", "value": "Espanhol básico" } },
    { "step_id": "import-text", "action": "fill", "locator": { "kind": "css", "selector": "#imp-text" }, "value": { "source": "literal", "value": "hola\tolá\ngracias\tobrigado\nperro\tcachorro\n{{c1::Madrid}} es la capital de España\nsin verso" } },
    { "step_id": "import-preview", "action": "wait_for_timeout", "duration_ms": 500 },
    { "step_id": "import-go", "action": "click", "locator": { "kind": "css", "selector": ".editor-actions .btn--primary" }, "timeout_ms": 8000 },
    { "step_id": "deck-cards", "action": "wait_for", "locator": { "kind": "css", "selector": ".note-list" }, "state": "visible", "timeout_ms": 10000 },
    { "step_id": "search", "action": "fill", "locator": { "kind": "css", "selector": "input[aria-label='Pesquisar cartões']" }, "value": { "source": "literal", "value": "perro" } },
    { "step_id": "search-result", "action": "wait_for_timeout", "duration_ms": 500 },
    { "step_id": "open-menu", "action": "click", "locator": { "kind": "css", "selector": ".page-head__actions button[aria-label='Mais opções']" }, "timeout_ms": 8000 },
    { "step_id": "archive", "action": "click", "locator": { "kind": "role", "role": "menuitem", "name": "Arquivar" }, "timeout_ms": 8000 },
    { "step_id": "archive-confirm", "action": "click", "locator": { "kind": "css", "selector": ".modal__foot .btn--primary" }, "timeout_ms": 8000 },
    { "step_id": "archived-banner", "action": "wait_for", "locator": { "kind": "css", "selector": ".banner" }, "state": "visible", "timeout_ms": 8000 },
    { "step_id": "archive-page", "action": "goto", "destination": { "url": "http://localhost:5180/archive" }, "wait_until": "load" },
    { "step_id": "archive-list", "action": "wait_for", "locator": { "kind": "css", "selector": ".list" }, "state": "visible", "timeout_ms": 8000 },
    { "step_id": "restore", "action": "click", "locator": { "kind": "css", "selector": "button:has-text('Restaurar')" }, "timeout_ms": 8000 },
    { "step_id": "archive-empty", "action": "wait_for", "locator": { "kind": "css", "selector": ".empty" }, "state": "visible", "timeout_ms": 8000 },
    { "step_id": "home", "action": "goto", "destination": { "url": "http://localhost:5180/" }, "wait_until": "load" },
    { "step_id": "home-ready", "action": "wait_for", "locator": { "kind": "css", "selector": "main .list" }, "state": "visible", "timeout_ms": 8000 },
    { "step_id": "row-menu", "action": "click", "locator": { "kind": "css", "selector": ".deck-row button[aria-label='Mais opções']" }, "timeout_ms": 8000 },
    { "step_id": "delete", "action": "click", "locator": { "kind": "role", "role": "menuitem", "name": "Excluir" }, "timeout_ms": 8000 },
    { "step_id": "delete-confirm", "action": "click", "locator": { "kind": "css", "selector": ".modal__foot .btn--danger" }, "timeout_ms": 8000 },
    { "step_id": "home-after-delete", "action": "wait_for_timeout", "duration_ms": 800 },
    { "step_id": "trash", "action": "goto", "destination": { "url": "http://localhost:5180/trash" }, "wait_until": "load" },
    { "step_id": "trash-list", "action": "wait_for", "locator": { "kind": "css", "selector": ".list" }, "state": "visible", "timeout_ms": 8000 },
    { "step_id": "trash-restore", "action": "click", "locator": { "kind": "css", "selector": "button:has-text('Restaurar')" }, "timeout_ms": 8000 },
    { "step_id": "activity", "action": "goto", "destination": { "url": "http://localhost:5180/activity" }, "wait_until": "load" },
    { "step_id": "activity-ready", "action": "wait_for", "locator": { "kind": "css", "selector": ".calendar" }, "state": "visible", "timeout_ms": 8000 },
    { "step_id": "settings", "action": "goto", "destination": { "url": "http://localhost:5180/settings" }, "wait_until": "load" },
    { "step_id": "dark-theme", "action": "click", "locator": { "kind": "css", "selector": ".theme-cell:has-text('Escuro')" }, "timeout_ms": 8000 },
    { "step_id": "dark-settled", "action": "wait_for_timeout", "duration_ms": 600 },
    { "step_id": "home-dark", "action": "goto", "destination": { "url": "http://localhost:5180/" }, "wait_until": "load" },
    { "step_id": "home-dark-ready", "action": "wait_for", "locator": { "kind": "css", "selector": "main .list" }, "state": "visible", "timeout_ms": 8000 },
    { "step_id": "ai", "action": "goto", "destination": { "url": "http://localhost:5180/ai" }, "wait_until": "load" },
    { "step_id": "ai-ready", "action": "wait_for", "locator": { "kind": "css", "selector": ".format-grid" }, "state": "visible", "timeout_ms": 10000 }
  ],
  "capture": { "after_each_step": ["url", "screenshot"] }
}
